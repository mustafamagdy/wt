{
  "name": "git-wt",
  "version": "2.3.0",
  "description": "Typed Git worktree management library and interactive CLI",
  "type": "module",
  "main": "./dist/core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "wt": "./bin/wt"
  },
  "scripts": {
    "build": "bun run clean && bun build src/cli.ts --target=node --minify --outfile=bin/wt --banner='#!/usr/bin/env node' && bun build src/index.ts --target=node --format=esm --minify --outfile=dist/core.js && tsc -p tsconfig.build.json && chmod +x bin/wt",
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "test": "bun test",
    "pack:check": "bun pm pack --dry-run",
    "verify": "bun run check && bun test && bun run build && bun run pack:check && bin/wt --help",
    "postinstall": "echo '\n\u2705 git-wt installed! Run \"wt help\" to get started.\n'",
    "prepublishOnly": "bun run verify"
  },
  "keywords": [
    "git",
    "worktree",
    "workflow",
    "branch",
    "development",
    "cli",
    "tool",
    "cross-platform"
  ],
  "author": "Mustafa Magdy <mustafa.magdy1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafamagdy/wt.git"
  },
  "bugs": {
    "url": "https://github.com/mustafamagdy/wt.git/issues"
  },
  "homepage": "https://github.com/mustafamagdy/wt.git#readme",
  "engines": {
    "node": ">=20.12.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "preferGlobal": true,
  "files": [
    "bin/",
    "dist/",
    "skills/",
    "README.md",
    "LICENSE",
    "CONTEXT.md",
    "docs/adr/"
  ],
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "commander": "14.0.2",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2"
  }
}
