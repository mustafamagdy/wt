{
  "name": "git-wt",
  "version": "2.0.0",
  "description": "Cross-platform Git worktree management tool with intelligent partial matching and tagging",
  "type": "module",
  "main": "bin/wt",
  "bin": {
    "wt": "./bin/wt"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile=bin/wt --banner='#!/usr/bin/env node' && chmod +x bin/wt",
    "check": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run check && bun test && bun run build && bin/wt --help",
    "postinstall": "echo '\n✅ git-wt installed! Run \"wt help\" to get started.\n'",
    "prepublishOnly": "bun run verify"
  },
  "keywords": [
    "git",
    "worktree",
    "workflow",
    "branch",
    "development",
    "cli",
    "tool",
    "cross-platform"
  ],
  "author": "Mustafa Magdy <mustafa.magdy1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafamagdy/wt.git"
  },
  "bugs": {
    "url": "https://github.com/mustafamagdy/wt.git/issues"
  },
  "homepage": "https://github.com/mustafamagdy/wt.git#readme",
  "engines": {
    "node": ">=20.12.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "preferGlobal": true,
  "files": [
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "commander": "14.0.2",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2"
  }
}
